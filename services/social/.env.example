# Eva - Twitter/X Autopost Config (local)
# Get keys: https://developer.x.com  (Free tier = 1 post/24h)

# X API credentials
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret
X_BEARER_TOKEN=your_bearer_token

# Posting config
POST_FREQUENCY=daily          # daily | twice_daily | custom (upgrade to X Basic tier for >1/day)
POST_TIME_PDT=09:00           # local time to autopost
TIMEZONE=America/Los_Angeles

# Guardrail (Eva runs this before EVERY post - never bypass)
GUARDRAIL_ENABLED=true
GUARDRAIL_RULES=compliance.md
