# EVA Deal Scout — Chad $5MM+ deal box environment template.
# Copy to `.env` (git-ignored) and fill in real values before going live.
# Never commit real secrets — this file holds EXAMPLE/placeholder values only.

# --- GHL (GoHighLevel) intake routing -------------------------------------
# Chad's intake routes into his OWN pipeline — NEVER the protected
# "Eva Acquisition" pipeline (id hODxp7jDIraP6FaNZqNU).
# REQUIRED before go-live: real pipeline id (no safe default exists).
GHL_CHAD_PIPELINE_ID=TODO_REPLACE_WITH_REAL_PIPELINE_ID
# Optional: pipeline stage id for the created opportunity. When unset, the
# contact is upserted but no opportunity/stage is created.
GHL_CHAD_STAGE_ID=
# Location id defaults to the Mangotec location (safe — a location, not the
# protected pipeline). Override only if intake should live elsewhere.
GHL_CHAD_LOCATION_ID=kyK4yAY6Hur3F4deCx2n

# --- GHL inbound webhook shared secret -------------------------------------
# When set, POST /box/ghl/intake requires a matching `X-Webhook-Secret` header
# (missing/wrong -> 401). When unset, the route is open and logs a warning.
# The value below is a generated EXAMPLE — replace with your own secret.
GHL_WEBHOOK_SECRET=E76YC0B5uee4Eugm0Yu7moLmiHQKnVG969PoiYWi4MM

# --- Gmail (result-email delivery) -----------------------------------------
# Real SMTP send is enabled only when EVA_OUTREACH_SENDER=gmail AND
# GMAIL_APP_PASSWORD is set. Otherwise intake still records an email_status
# but no mail is sent.
EVA_OUTREACH_SENDER=gmail
# REQUIRED for real email: a Google App Password for the sending account.
GMAIL_APP_PASSWORD=
# From address (default info@mangotecusa.com); sender display name "Vineet Ravi".
GMAIL_SENDER_EMAIL=info@mangotecusa.com
# Optional: authenticating Gmail/Workspace account (defaults to GMAIL_SENDER_EMAIL).
GMAIL_USER=info@mangotecusa.com

# --- Public URL for the live results link ----------------------------------
DEAL_SCOUT_PUBLIC_URL=http://localhost:8766
